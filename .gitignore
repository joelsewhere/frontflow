# Python bytecode. The repo had no root .gitignore, so these showed up
# as untracked noise on every test run.
__pycache__/
*.py[cod]

# Local virtualenvs. `python -m venv` writes its own .gitignore inside
# .venv, but a differently-named env would not be covered.
.venv/
venv/
env/

# Real secrets. deploy/.env.example is the template that IS committed.
.env
deploy/.env

# Build outputs
dist/
build/
*.egg-info/

# Test/tooling caches
.pytest_cache/
*.tsbuildinfo

.DS_Store

# esbuild output for the pure-logic frontend tests. The .test.cjs files
# are source; the bundles they require are generated beside them.
frontend/src/**/*.cjs
!frontend/src/**/*.test.cjs
