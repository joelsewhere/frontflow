# ---------- Postgres ----------
POSTGRES_USER=frontflow
POSTGRES_PASSWORD=change-me-postgres
# frontflow's own database.
POSTGRES_DB=frontflow
# Superset's metadata database (separate from frontflow's data).
SUPERSET_METADATA_DB=superset
# Read-only role Superset uses to read frontflow's data. It can never write.
SUPERSET_RO_USER=superset_ro
SUPERSET_RO_PASSWORD=change-me-readonly
# Host port for psql only. Change if 5432 is taken on your machine;
# services reach Postgres as postgres:5432 regardless.
POSTGRES_HOST_PORT=5432

# ---------- frontflow ----------
FRONTFLOW_PORT=8000
FRONTFLOW_SECRET_KEY=change-me-run-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key
# Directory of workflow .py files to serve.
WORKFLOWS_DIR=./workflows

# The origin frontflow is served from.
#
# SECURITY: this is the allowed-domains list on every dashboard
# frontflow provisions. Superset treats an EMPTY list as "any domain may
# embed" (is_referrer_allowed = not embedded.allowed_domains), so
# leaving it unset publishes your dashboards to any site that iframes
# them. Set it.
FRONTFLOW_PUBLIC_ORIGIN=http://localhost:8000

# The Superset URL a BROWSER should use for SESSION surfaces — Explore,
# the dashboard editor, new chart. Distinct from how frontflow reaches
# Superset internally (http://superset:8088), which is meaningless in a
# browser. Sign in to Superset at this URL.
FRONTFLOW_SUPERSET_PUBLIC_URL=http://localhost:8088

# The Superset URL guest-token EMBEDS mount from. Must differ in
# HOSTNAME from the one above — a different port is not enough.
#
# Superset's embedded view force-signs-in an anonymous user to build the
# page, which rewrites the Flask session cookie. Cookies are scoped by
# host and ignore ports, so if embeds share a hostname with the session
# surfaces, opening a dashboard panel silently signs you out of Explore
# and the editor. Two hostnames means two cookie jars.
#
# Locally 127.0.0.1 vs localhost does the job. In a deployment, point two
# hostnames at the same Superset.
FRONTFLOW_SUPERSET_EMBED_URL=http://127.0.0.1:8088

# The name frontflow's database is registered under inside Superset.
# Provisioning looks it up by this name to build datasets on.
FRONTFLOW_SUPERSET_DATABASE=FrontFlow

# ---------- Superset ----------
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
GUEST_TOKEN_JWT_SECRET=change-me-to-another-long-random-string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-admin
SUPERSET_ADMIN_EMAIL=admin@example.com
# How long a Superset sign-in lasts. Superset leaves its session cookie
# expiring with the browser, which shows up as a login screen inside the
# dashboard panel's Edit / New-chart frames after every restart.
SUPERSET_SESSION_DAYS=30
